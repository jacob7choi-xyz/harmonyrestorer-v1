# HarmonyRestorer Frontend Configuration
# Copy to .env.local and customize as needed.

# Base URL of the backend API, ending in /api/v1: src/api/client.ts appends /denoise,
# /status and /download to it. Unset, the page calls /api/v1 on its own origin, which the
# dev server forwards to http://localhost:8000 (vite.config.ts).
# VITE_API_URL=http://localhost:8000/api/v1

# Largest upload the page accepts, in MB (1 MB = 1024 * 1024 bytes). Set it to
# match the backend's MAX_UPLOAD_BYTES; the backend enforces its own limit.
# Unset or invalid values fall back to 50.
# VITE_MAX_UPLOAD_MB=50
